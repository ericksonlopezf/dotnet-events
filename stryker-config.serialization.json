{
  "stryker-config": {
    "project": "EricksonLopez.Events.Serialization.SystemTextJson.csproj",
    "test-projects": [
      "tests/EricksonLopez.Events.Serialization.Tests/EricksonLopez.Events.Serialization.Tests.csproj"
    ],
    "reporters": [
