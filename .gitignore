# ==============================================================================
# Security, Certificates & Strong Name Keys
# ==============================================================================
# Ignore private strong name keys & certificates by default
*.snk
*.pfx
*.p12
*.cer
*.crt
*.pem
*.key

# Allow only public/open-source strong name public keys
!public.snk
!*.pub.snk

# Local configuration, Secrets and Environment files
appsettings.Development.json
appsettings.Local.json
secrets.json
.env
.env.*
!.env.example

