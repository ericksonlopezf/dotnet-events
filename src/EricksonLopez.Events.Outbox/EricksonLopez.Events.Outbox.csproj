<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.Events.Outbox</AssemblyName>
    <RootNamespace>EricksonLopez.Events.Outbox</RootNamespace>
    <Description>Transactional Outbox bridge for EricksonLopez.Events. Implements IEventPublisher backed by EricksonLopez.Outbox.Abstractions for reliable at-least-once event delivery.</Description>
    <PackageTags>$(CommonPackageTags);outbox;transactional-outbox;at-least-once;dual-write;reliability;messaging;domain-events;integration-events;trimming</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Events.Contracts\EricksonLopez.Events.Contracts.csproj" />
    <ProjectReference Include="..\..\..\dotnet-outbox\src\EricksonLopez.Outbox.Abstractions\EricksonLopez.Outbox.Abstractions.csproj" 
                      Condition="Exists('..\..\..\dotnet-outbox\src\EricksonLopez.Outbox.Abstractions\EricksonLopez.Outbox.Abstractions.csproj')" />
    <PackageReference Include="EricksonLopez.Outbox.Abstractions" 
                      Condition="!Exists('..\..\..\dotnet-outbox\src\EricksonLopez.Outbox.Abstractions\EricksonLopez.Outbox.Abstractions.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Events.Outbox.Tests" />
  </ItemGroup>
</Project>
